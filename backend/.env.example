# Backend Configuration
# Copy to .env and adjust

# Server
NODE_ENV=development
PORT=3001

# Mode: 'mock' (local fake data) | 'proxy' (forward to real Midasbuy API)
MODE=mock

# CORS - frontend origin
CORS_ORIGIN=http://localhost:5173

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=30

# Midasbuy API (only used when MODE=proxy)
# Get API key from: https://t.me/NightStrang6r (NightsSoftware) or https://t.me/exfador (exfador)
MIDASBUY_API_KEY=
MIDASBUY_BASE_URL=https://midasbuy.night-apis.com
MIDASBUY_TIMEOUT=8000

# Mock data seed (deterministic nicknames)
MOCK_SEED=pubg-event-2026